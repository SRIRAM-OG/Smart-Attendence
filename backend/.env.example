PORT=3000
NODE_ENV=development

# Database connection URL (PostgreSQL default or SQLite for local dev)
# For PostgreSQL: postgresql://postgres:postgres@localhost:5432/smart_attendance?schema=public
# For SQLite (if needed): file:./dev.db
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smart_attendance?schema=public"

# JWT Secret Keys
JWT_SECRET="smart_attendance_super_secret_jwt_access_key_2026"
JWT_REFRESH_SECRET="smart_attendance_super_secret_jwt_refresh_key_2026"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# QR Code Token Expiry (minutes)
QR_DEFAULT_EXPIRY_MINUTES=5
